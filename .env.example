# Chimera local development setup only.
# Copy to .env.local. Do not commit your real .env.local file.
# These values are examples/empty placeholders, NOT active checkout configuration.

# Use the custom https:// domain AFTER Netlify DNS and SSL are verified.
NEXT_PUBLIC_SITE_URL=https://chimerawater.netlify.app

# Stripe checkout integration (NOT currently implemented).
# Keep secret values server-side in a Netlify Function only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Six separate price IDs for five product listings.
# These are Stripe Price IDs (price_...), NOT Shopify variant IDs.
STRIPE_PRICE_CARAFE=
STRIPE_PRICE_FILTER_BLACK=
STRIPE_PRICE_FILTER_WHITE=
STRIPE_PRICE_CHARCOAL_2OZ=
STRIPE_PRICE_CHARCOAL_12OZ=
STRIPE_PRICE_KIT=

# Optional: Only needed if using Stripe.js / Stripe Elements in the browser.
# Stripe-hosted checkout redirects do not require it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
