# Chimera Water — copy this file to .env.local for testing with "netlify dev".
# NEVER commit .env.local or send secret values in chat.
# Netlify: Project configuration > Environment variables; configure for Functions/runtime.
# After adding or changing Netlify variables, trigger a new deploy to apply them.

# Used for local/public frontend settings only. NOT a secret.
NEXT_PUBLIC_SITE_URL=https://chimerawater.com
# Leave false while keys/prices/shipping are pending. Rebuild to change the frontend.
NEXT_PUBLIC_STRIPE_CHECKOUT_ENABLED=false

# Netlify Functions only: start with sk_test_, never sk_live_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Scott must set up these SIX Stripe Price IDs in test mode; no pricing is assumed.
STRIPE_PRICE_CARAFE=
STRIPE_PRICE_FILTER_BLACK=
STRIPE_PRICE_FILTER_WHITE=
STRIPE_PRICE_CHARCOAL_2OZ=
STRIPE_PRICE_CHARCOAL_12OZ=
STRIPE_PRICE_KIT=

# Seller-approved Stripe Shipping Rate ID and destination countries, e.g. US
# Do not guess shipping costs or countries.
STRIPE_SHIPPING_RATE_ID=
STRIPE_ALLOWED_SHIPPING_COUNTRIES=

# Explicit server-side test-only switch; leave false until all setup and approvals.
STRIPE_CHECKOUT_ENABLED=false
# Only enable if Stripe Tax is configured and business tax handling is approved.
STRIPE_ENABLE_AUTOMATIC_TAX=false
